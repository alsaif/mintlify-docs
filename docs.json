{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Nushir",
  "description": "Plan, schedule and publish social content across every channel from one calendar.",
  "colors": {
    "primary": "#A8632A",
    "light": "#D68F4E",
    "dark": "#121110"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://nushir.com"
  },
  "navbar": {
    "links": [
      { "label": "Sign in", "href": "https://platform.nushir.com/auth/login" }
    ],
    "primary": {
      "type": "button",
      "label": "Start free",
      "href": "https://platform.nushir.com/auth"
    }
  },
  "footer": {
    "links": [
      {
        "header": "Nushir",
        "items": [
          { "label": "Home", "href": "https://nushir.com" },
          { "label": "Pricing", "href": "https://nushir.com/en/pricing.html" },
          { "label": "Sign in", "href": "https://platform.nushir.com/auth/login" }
        ]
      },
      {
        "header": "Legal",
        "items": [
          { "label": "Terms", "href": "https://nushir.com/en/terms.html" },
          { "label": "Privacy", "href": "https://nushir.com/en/privacy.html" },
          { "label": "Cookies", "href": "https://nushir.com/en/cookies.html" }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "guide/quickstart",
              "guide/concepts",
              "guide/where-things-live"
            ]
          },
          {
            "group": "Channels",
            "pages": [
              "guide/channels/connect",
              "guide/channels/manage",
              "guide/channels/time-slots",
              "guide/channels/customers"
            ]
          },
          {
            "group": "Writing a post",
            "pages": [
              "guide/composer/overview",
              "guide/composer/global-vs-per-channel",
              "guide/composer/media",
              "guide/composer/threads-and-comments",
              "guide/composer/scheduling",
              "guide/composer/validation"
            ]
          },
          {
            "group": "Calendar and posts",
            "pages": [
              "guide/calendar",
              "guide/approvals",
              "guide/analytics",
              "guide/media-library"
            ]
          },
          {
            "group": "Automation",
            "pages": [
              "guide/automations/plugs",
              "guide/automations/rss",
              "guide/automations/webhooks"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "guide/settings/team",
              "guide/settings/developers"
            ]
          },
          {
            "group": "Account",
            "pages": [
              "account/plans",
              "account/billing"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "guide/troubleshooting/connecting",
              "guide/troubleshooting/publishing",
              "guide/troubleshooting/media"
            ]
          }
        ]
      },
      {
        "tab": "Platforms",
        "groups": [
          {
            "group": "Overview",
            "pages": ["channels/overview"]
          },
          {
            "group": "Reference",
            "pages": [
              "channels/x",
              "channels/linkedin",
              "channels/facebook",
              "channels/instagram",
              "channels/threads",
              "channels/tiktok",
              "channels/youtube",
              "channels/pinterest",
              "channels/reddit",
              "channels/discord",
              "channels/telegram",
              "channels/slack",
              "channels/mastodon",
              "channels/bluesky"
            ]
          }
