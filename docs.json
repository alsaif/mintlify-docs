  "redirects": [
    {
      "source": "/index",
      "destination": "/general/introduction"
    },
    {
      "source": "/guide/:slug*",
      "destination": "/general/:slug*"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/public-api/:slug*"
    },
    {
      "source": "/channels/:slug*",
      "destination": "/general/platforms/:slug*"
    },
    {
      "source": "/account/plans",
      "destination": "/cloud/plans"
    },
    {
      "source": "/account/billing",
      "destination": "/cloud/subscription"
    }
