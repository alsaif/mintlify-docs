  "keyFeatures": [
    "AI Planner Agent — builds a full monthly content calendar from your goals and local seasons",
    "AI Writer Agent — writes in your tone in Arabic and English, reshapes content per platform",
    "AI Designer Agent — generates images and short video in 3 crop ratios (1:1, 9:16, 16:9) using your brand assets",
    "AI Analyst Agent — reads post-publish numbers, adjusts timing and topics, generates monthly branded reports",
    "30+ channel integrations — social networks, video platforms, long-form blogs, communities, and messaging apps",
    "Draft-first workflow — nothing publishes without your review and approval",
    "Cross-posting with per-platform adaptation (different text length, format, and media per channel)",
    "Evergreen reposting — recycles high-performing content on a set cadence",
    "Team review and approval workflows with multi-user workspaces",
    "REST API, webhooks, MCP server, and CLI for developers and automation",
    "Arabic-first product — calendar, analytics, and tone built natively for Arabic speakers",
    "Agency workspaces — separate client environments with branded monthly reports"
  ],
  "publicApiSurface": [
    "POST /v1/posts — create a scheduled post",
    "GET /v1/posts — list scheduled posts",
    "POST /v1/channels — connect a channel (including custom webhook channels)",
    "GET /v1/channels — list connected channels",
    "GET /v1/analytics — retrieve post analytics",
    "POST /v1/webhooks — register a webhook endpoint",
    "MCP server — connect an AI agent (Claude, GPT, etc.) to Nushir",
    "nushir post create — CLI command to create a draft post",
    "nushir post list — CLI command to list scheduled posts"
  ]
